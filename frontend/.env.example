# copy this to frontend/.env.local and fill it in. .env.local is gitignored, never commit it.

# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# the publishable (anon) key -- safe to ship to the browser. Never put the secret/service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=

# where the FastAPI backend runs (defaults to this if left out)
VITE_API_URL=http://127.0.0.1:8000
