# copy this to backend/.env and fill it in. .env is gitignored, never commit it.

# where the frontend runs -- the links in emails point here
FRONTEND_URL=http://localhost:5173

# gmail account the app sends from. use a throwaway/team gmail, not your personal one.
#   1. turn on 2-Step Verification on that google account
#   2. make an app password at https://myaccount.google.com/apppasswords
#   3. paste the 16 characters below (spaces are fine)
# leave these blank and emails just get printed to the backend console instead
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Social Scheduler

# how long the accept/decline link in a friend request email works
FRIEND_REQUEST_TTL_DAYS=7

# --- supabase auth ---
# Project URL: Supabase dashboard -> Project Settings -> API. Same value as VITE_SUPABASE_URL in frontend/.env.local.
# The backend checks every request's login token against this project's public signing keys.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only if your project still uses the legacy shared JWT secret (Project Settings -> JWT Keys -> Legacy).
# Leave blank for projects on the newer signing keys. This is a SECRET -- never commit it.
SUPABASE_JWT_SECRET=

# extra origins allowed to call the api from a browser, comma separated. Defaults to FRONTEND_URL.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
