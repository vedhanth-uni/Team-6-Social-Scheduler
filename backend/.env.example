# copy this to backend/.env and fill it in. .env is gitignored, never commit it.

# where the frontend runs -- the links in emails point here
FRONTEND_URL=http://localhost:5173

# gmail account the app sends from. use a throwaway/team gmail, not your personal one.
#   1. turn on 2-Step Verification on that google account
#   2. make an app password at https://myaccount.google.com/apppasswords
#   3. paste the 16 characters below (spaces are fine)
# leave these blank and emails just get printed to the backend console instead
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Social Scheduler

# how long the accept/decline link in a friend request email works
FRIEND_REQUEST_TTL_DAYS=7
