# copy this to backend/.env and fill it in. .env is gitignored, never commit it.

# supabase postgres connection string
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# project url: supabase dashboard -> project settings -> api. same as VITE_SUPABASE_URL in the frontend
SUPABASE_URL=https://your-project-ref.supabase.co
# only if your project still uses the legacy shared jwt secret, leave blank otherwise
SUPABASE_JWT_SECRET=

# where the frontend runs
FRONTEND_URL=http://localhost:5173
# extra origins allowed to call the api from a browser, comma separated. defaults to FRONTEND_URL
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# gmail account the app sends friend request emails from. use a team gmail, not your personal one.
#   1. turn on 2-step verification on that google account
#   2. make an app password at https://myaccount.google.com/apppasswords
#   3. paste the 16 characters below (spaces are fine)
# leave these blank and emails just get printed to the backend console instead
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Social Scheduler
